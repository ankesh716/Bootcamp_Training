//maximum area rectangle//
class Solution {
    public int calArea(int[][] arr) {
        // code here
 {
                int max = 0;

                for (int i = 0; i < arr.length; i++) {
                    int area = arr[i][0] * arr[i][1];
                    max = Math.max(max, area);
                }

                return max;
            }
        }
    }
